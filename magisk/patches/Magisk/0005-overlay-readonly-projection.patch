+/// Partitions that the opt-in read-only overlay projection extracts and mounts.
+const OVERLAY_PARTITIONS: [&str; 3] = ["vendor", "product", "system_ext"];
+
+/// Whether a module knowingly accepts the read-only projection.
+///
+/// The value must be `1` or `true`, as with the other valued module flags.
+fn overlay_opted(module: &str) -> bool {
+    let root = std::path::Path::new(MODULEROOT).join(module);
+    egysk_runtime::store::valued_flag(&root, egysk_runtime::projection::OVERLAY_MARKER)
+        .unwrap_or_else(|error| {
+            egysk_runtime::fatal_boot(&format!("module overlay marker: {error:#}"))
+        })
+}
+
+/// Absolute Android paths a Magic Mount tree claims: files, symlinks, and
+/// whiteouts, plus directories it binds wholesale for a replaced directory.
+///
+/// A merged directory is not a claim, because both projection methods merge
+/// real directories. The `.replace` marker is a decision, not a path.
+fn claimed_paths(node: &FsNode, prefix: &str, claimed: &mut Vec<String>) {
+    let FsNode::Directory { children } = node else {
+        return;
+    };
+    let replaces = matches!(children.get(".replace"), Some(FsNode::File { .. }));
+    for (name, child) in children {
+        if name == ".replace" {
+            continue;
+        }
+        let path = format!("{prefix}/{name}");
+        match child {
+            FsNode::Directory { .. } => {
+                if replaces {
+                    // The native replace path binds this child directory
+                    // recursively, so it covers every path below it.
+                    claimed.push(path);
+                } else {
+                    claimed_paths(child, &path, claimed);
+                }
+            }
+            _ => claimed.push(path),
+        }
+    }
+}
+
+/// Mount flags for an overlay layer, including the read-only contract.
+fn overlay_flags(flags: &[egysk_runtime::projection::Flag]) -> MsFlags {
+    use egysk_runtime::projection::Flag;
+    let mut out = MsFlags::empty();
+    for flag in flags {
+        out |= match flag {
+            Flag::ReadOnly => MsFlags::MS_RDONLY,
+            Flag::NoSuid => MsFlags::MS_NOSUID,
+            Flag::NoDev => MsFlags::MS_NODEV,
+            Flag::NoExec => MsFlags::MS_NOEXEC,
+            Flag::NoAtime => MsFlags::MS_NOATIME,
+            Flag::NoDirAtime => MsFlags::MS_NODIRATIME,
+            // nix exposes no constant for this Linux 5.10 flag.
+            Flag::NoSymFollow => {
+                MsFlags::from_bits_retain(libc::MS_NOSYMFOLLOW as libc::c_ulong)
+            }
+        };
+    }
+    out
+}
